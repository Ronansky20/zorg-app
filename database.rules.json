{
  "rules": {
    "users": {
      ".read": "auth != null"
    },
    "patients": {
      "$patientId": {
        ".read": "auth != null && (!data.exists() || (data.child('careTeam').child(auth.uid).val() === true && (root.child('users').child(auth.uid).child('profession').val() === 'DOCTOR' || root.child('users').child(auth.uid).child('profession').val() === 'PHYSIOTHERAPIST' || root.child('users').child(auth.uid).child('profession').val() === 'DENTIST')))",
        ".write": "auth != null && !data.exists() && newData.child('careTeam').child(auth.uid).val() === true && (root.child('users').child(auth.uid).child('profession').val() === 'DOCTOR')",
        ".validate": "newData.hasChildren(['firstName', 'lastName', 'weight', 'height', 'careTeam'])",
        "firstName": {
          ".read": "auth != null && data.parent().child('careTeam').child(auth.uid).val() === true && (root.child('users').child(auth.uid).child('profession').val() === 'DOCTOR' || root.child('users').child(auth.uid).child('profession').val() === 'PHARMACIST' || root.child('users').child(auth.uid).child('profession').val() === 'PHYSIOTHERAPIST' || root.child('users').child(auth.uid).child('profession').val() === 'DENTIST')",
          ".write": "auth != null && data.parent().child('careTeam').child(auth.uid).val() === true && (root.child('users').child(auth.uid).child('profession').val() === 'DOCTOR' || root.child('users').child(auth.uid).child('profession').val() === 'PHYSIOTHERAPIST' || root.child('users').child(auth.uid).child('profession').val() === 'DENTIST')",
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "lastName": {
          ".read": "auth != null && data.parent().child('careTeam').child(auth.uid).val() === true && (root.child('users').child(auth.uid).child('profession').val() === 'DOCTOR' || root.child('users').child(auth.uid).child('profession').val() === 'PHARMACIST' || root.child('users').child(auth.uid).child('profession').val() === 'PHYSIOTHERAPIST' || root.child('users').child(auth.uid).child('profession').val() === 'DENTIST')",
          ".write": "auth != null && data.parent().child('careTeam').child(auth.uid).val() === true && (root.child('users').child(auth.uid).child('profession').val() === 'DOCTOR' || root.child('users').child(auth.uid).child('profession').val() === 'PHYSIOTHERAPIST' || root.child('users').child(auth.uid).child('profession').val() === 'DENTIST')",
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "birthDate": {
          ".read": "auth != null && data.parent().child('careTeam').child(auth.uid).val() === true && (root.child('users').child(auth.uid).child('profession').val() === 'DOCTOR' || root.child('users').child(auth.uid).child('profession').val() === 'PHARMACIST' || root.child('users').child(auth.uid).child('profession').val() === 'PHYSIOTHERAPIST' || root.child('users').child(auth.uid).child('profession').val() === 'DENTIST')",
          ".write": "auth != null && data.parent().child('careTeam').child(auth.uid).val() === true && (root.child('users').child(auth.uid).child('profession').val() === 'DOCTOR')",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "weight": {
          ".read": "auth != null && data.parent().child('careTeam').child(auth.uid).val() === true && (root.child('users').child(auth.uid).child('profession').val() === 'DOCTOR' || root.child('users').child(auth.uid).child('profession').val() === 'PHYSIOTHERAPIST' || root.child('users').child(auth.uid).child('profession').val() === 'DENTIST')",
          ".write": "auth != null && data.parent().child('careTeam').child(auth.uid).val() === true && (root.child('users').child(auth.uid).child('profession').val() === 'DOCTOR' || root.child('users').child(auth.uid).child('profession').val() === 'PHYSIOTHERAPIST')",
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "height": {
          ".read": "auth != null && data.parent().child('careTeam').child(auth.uid).val() === true && (root.child('users').child(auth.uid).child('profession').val() === 'DOCTOR' || root.child('users').child(auth.uid).child('profession').val() === 'PHYSIOTHERAPIST' || root.child('users').child(auth.uid).child('profession').val() === 'DENTIST')",
          ".write": "auth != null && data.parent().child('careTeam').child(auth.uid).val() === true && (root.child('users').child(auth.uid).child('profession').val() === 'DOCTOR' || root.child('users').child(auth.uid).child('profession').val() === 'PHYSIOTHERAPIST')",
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "address": {
          ".read": "auth != null && data.parent().child('careTeam').child(auth.uid).val() === true && (root.child('users').child(auth.uid).child('profession').val() === 'DOCTOR' || root.child('users').child(auth.uid).child('profession').val() === 'PHYSIOTHERAPIST' || root.child('users').child(auth.uid).child('profession').val() === 'DENTIST')",
          ".write": "auth != null && data.parent().child('careTeam').child(auth.uid).val() === true && (root.child('users').child(auth.uid).child('profession').val() === 'DOCTOR' || root.child('users').child(auth.uid).child('profession').val() === 'PHYSIOTHERAPIST' || root.child('users').child(auth.uid).child('profession').val() === 'DENTIST')",
          ".validate": "newData.isString()"
        },
        "medications": {
          ".read": "auth != null && data.parent().child('careTeam').child(auth.uid).val() === true && (root.child('users').child(auth.uid).child('profession').val() === 'DOCTOR' || root.child('users').child(auth.uid).child('profession').val() === 'PHARMACIST' || root.child('users').child(auth.uid).child('profession').val() === 'PHYSIOTHERAPIST' || root.child('users').child(auth.uid).child('profession').val() === 'DENTIST')",
          ".write": "auth != null && data.parent().child('careTeam').child(auth.uid).val() === true && (root.child('users').child(auth.uid).child('profession').val() === 'DOCTOR')",
          "$index": {
            ".validate": "newData.hasChildren(['name'])",
            "name": {
              ".validate": "(newData.val() === 'Paracetamol' || newData.val() === 'Ibuprofen' || newData.val() === 'Amoxicillin' || newData.val() === 'Omeprazole' || newData.val() === 'Metformin' || newData.val() === 'Simvastatin' || newData.val() === 'Amlodipine' || newData.val() === 'Levothyroxine' || newData.val() === 'Insulin' || newData.val() === 'Heparin' || newData.val() === 'Vitamin B12' || newData.val() === 'Adrenaline' || newData.val() === 'Ceftriaxone' || newData.val() === 'Enoxaparin' || newData.val() === 'Morphine' || newData.val() === 'Influenza vaccine' || newData.val() === 'Hydrocortisone' || newData.val() === 'Fusidic acid' || newData.val() === 'Betamethasone' || newData.val() === 'Mupirocin' || newData.val() === 'Clotrimazole' || newData.val() === 'Miconazole' || newData.val() === 'Zinc oxide' || newData.val() === 'Silver sulfadiazine')"
            },
            "dosage": {
              ".validate": "newData.isString()"
            },
            "frequency": {
              ".validate": "newData.isString()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "careTeam": {
          ".read": "auth != null && data.child(auth.uid).val() === true",
          "$userId": {
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "userPatients": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        "$patientId": {
          ".write": "auth != null && newData.parent().parent().parent().child('patients').child($patientId).child('careTeam').child(auth.uid).val() === true && newData.exists() === (newData.parent().parent().parent().child('patients').child($patientId).child('careTeam').child($userId).val() === true)",
          ".validate": "newData.val() === true"
        }
      }
    }
  }
}
